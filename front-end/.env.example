# Copie este arquivo para .env (PowerShell: Copy-Item .env.example .env).
# Tudo que começa com VITE_ é incluído no JavaScript entregue ao navegador:
# NÃO coloque senhas, tokens ou segredos aqui.

# Nome exibido na aba do navegador e no rodapé
VITE_APP_NAME=Control EP

# Endereço da API (back-end). Precisa constar em FRONTEND_ORIGINS no .env do back-end.
VITE_API_BASE_URL=http://localhost:4500

# ID do papel solicitado no autocadastro (tabela "role"). O administrador confirma
# ou altera o papel ao aprovar o cadastro.
VITE_REGISTER_ROLE_ID=2

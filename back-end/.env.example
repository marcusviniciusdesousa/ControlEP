# =========================================================
# Control EP - API (back-end)
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# O arquivo .env NUNCA deve ser enviado ao Git.
# =========================================================

# Porta HTTP da API
PORT=4500

# Ambiente: development | production
# Em production os cookies passam a exigir HTTPS (Secure).
NODE_ENV=development

# Conexão PostgreSQL (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:sua-senha@localhost:5432/controlep
# SSL da conexão: deixe vazio para seguir a connection string (ex.: ?sslmode=require),
# "true" para forçar SSL sem validar certificado, "false" para banco local sem SSL.
DATABASE_SSL=
# Fuso horário usado para interpretar datas nos filtros de período (ex.: uso de equipamentos)
DB_TIMEZONE=America/Sao_Paulo

# Origens do front-end autorizadas (CORS com cookies), separadas por vírgula
FRONTEND_ORIGINS=http://localhost:5173

# Segredos de assinatura dos tokens JWT. Use valores longos, aleatórios e diferentes entre si.
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=troque-por-um-valor-aleatorio-longo
REFRESH_TOKEN_SECRET=troque-por-outro-valor-aleatorio-longo

# Duração da sessão
# Access token: curto, renovado automaticamente pelo front-end.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token: renovado a cada uso; a sessão só expira após este tempo SEM uso.
REFRESH_TOKEN_TTL_HOURS=12

# Cookies (opcional). Para front e API em domínios diferentes, use
# COOKIE_SAMESITE=none e COOKIE_SECURE=true (exige HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# E-mail para recuperação de senha (Gmail: use uma "Senha de app")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Opcional: força SSL direto (true) ou STARTTLS (false). Padrão: true na porta 465.
EMAIL_SECURE=
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app
